[Unit]
Description=Arduino UNO Q composite USB gadget (network + fileshare)
Documentation=file:/home/arduino/two-computers-one-board/usb/gadget-up.sh

# The fileshare image lives on /home/arduino, a separate partition that mounts
# around 13s. Binding the gadget before it is there gives the host an empty
# drive it will happily cache as empty.
RequiresMountsFor=/home/arduino

# configfs is where the gadget is defined; without it gadget-up.sh has nowhere
# to write.
After=sys-kernel-config.mount
Wants=sys-kernel-config.mount

[Service]
Type=oneshot
RemainAfterExit=yes

# Whether the gadget may touch the default route, and the other settings listed
# in docs/reference/configuration.md. The leading - means a board without the
# file still works: every setting has a default. Created by provision/60-usb-gadget.sh,
# and never rewritten by it, so an edit here survives re-provisioning.
EnvironmentFile=-/etc/default/unoq-usb

# This unit only ever PREPARES: it builds the gadget definition in configfs and
# brings up br-usb + DHCP. It deliberately does not bind, and --build makes
# that explicit rather than incidental.
#
# Binding lives in unoq-usb-bind.service, which udev starts when a controller
# actually appears. It has to be a separate unit because this one is
# RemainAfterExit=yes: systemd will not re-run a oneshot it still considers
# active, so a udev trigger aimed here would do nothing at all.
ExecStart=/home/arduino/two-computers-one-board/usb/gadget-up.sh --build
ExecStart=/home/arduino/two-computers-one-board/usb/usb-net-up.sh

ExecStop=/home/arduino/two-computers-one-board/usb/gadget-down.sh

[Install]
WantedBy=multi-user.target
