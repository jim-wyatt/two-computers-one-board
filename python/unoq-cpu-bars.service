[Unit]
Description=Arduino UNO Q host CPU load on the LED matrix
Documentation=file:/home/arduino/two-computers-one-board/docs/reference/mpu.md

# /dev/ttyHS1 reads nothing until link-up.sh has driven the UART enable GPIO,
# so this is a hard dependency rather than an ordering hint: without it the
# service starts, finds a silent port, and restarts forever.
Requires=unoq-link.service
After=unoq-link.service
# How long this may go on failing before systemd stops trying and calls it
# failed: twelve starts in five minutes. Measured on the board, with the MCU
# held in reset, one attempt takes about twelve seconds (the handshake times
# out, then RestartSec), so that is about two and a half minutes of a
# microcontroller that does not answer.
#
# Without a limit it retried for ever, and "restarting" is not "failed". On a
# board whose MCU had lost its firmware this unit restarted forty-five times
# in ten minutes while `systemctl --failed` stayed empty and LED 2, which
# reports failed units, stayed green: the matrix was dark and every light
# Linux owns said the board was fine.
#
# The limit is this loose because silence is sometimes normal. Flashing holds
# the MCU in reset for the better part of a minute - five attempts - and the boot race the
# Restart= line below exists for takes a few seconds. Neither comes near it.
# Recover, once the MCU is answering again:
#   sudo systemctl reset-failed unoq-cpu-bars && sudo systemctl start unoq-cpu-bars
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
User=arduino
Group=arduino
ExecStart=/home/arduino/two-computers-one-board/.venv/bin/unoq-cpu-bars --interval 0.5

# The MCU may still be coming up when the MPU reaches multi-user.target, and
# the shell handshake times out if it is. Retrying is the whole recovery: the
# next attempt a few seconds later finds a live shell.
Restart=on-failure
RestartSec=5

# SIGTERM reaches Python as a plain kill, not KeyboardInterrupt, so the
# finally: that blanks the panel never runs and the last frame stays lit
# forever. SIGINT takes the same path as Ctrl-C and leaves the panel dark.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
