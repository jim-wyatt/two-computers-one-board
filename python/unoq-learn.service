[Unit]
Description=Arduino UNO Q learning content and installers over HTTP
Documentation=file:/home/arduino/two-computers-one-board/python/unoq/learn.py

# The content lives inside the FAT32 image mounted at /srv/unoq-share, which is
# a loop mount of a file on /home/arduino - itself a separate partition that
# mounts around 13s. Without this the server starts first, finds an empty
# directory, and serves 404s for as long as it stays up.
RequiresMountsFor=/srv/unoq-share

# Ordering only, and a secondary improvement rather than the fix - the loopback
# URL was the AF_NETLINK restriction below, not this. But this unit was ordered
# against nothing and started a second before unoq-usb-gadget created br-usb,
# so the addresses it prints are a snapshot taken before there was anything to
# see. Ordering makes the snapshot worth taking.
#
# After= without Wants=/Requires= on purpose: the USB gadget is an OPTIONAL
# feature (provision/95-usb-gadget.sh), and the learning site has to serve on a
# board that never installed it. If the unit is absent or disabled this is a
# no-op, which is exactly what is wanted - it must not pull the gadget in.
#
# It still does not cover the general case: the link gets its address when a
# host is plugged in, which can be hours later. learn.py handles that by saying
# so rather than inventing an address.
After=unoq-usb-gadget.service

[Service]
Type=simple
User=arduino
Group=arduino
ExecStart=/home/arduino/two-computers-one-board/.venv/bin/unoq-learn --root /srv/unoq-share --port 8080

# It serves a read-only mount and needs nothing else on the box. These cost
# nothing and mean a bug in a stdlib HTTP handler reachable over a USB cable
# cannot reach the rest of the board.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
# AF_NETLINK IS NOT DECORATION. Without it this unit printed a loopback URL as
# the address to browse to, on a board whose USB link was up and answering on
# two addresses. nss-myhostname resolves the local hostname by asking the
# kernel for local addresses over a NETLINK socket; blocked, it falls back to
# 127.0.0.2 - documented behavior, and indistinguishable from "no network".
#
# Reproduced with systemd-run, same command, three sandboxes:
#   unrestricted                      -> 10.55.0.1, 192.168.137.210
#   AF_INET AF_INET6 AF_UNIX          -> 127.0.0.2        <- this unit
#   ... plus AF_NETLINK               -> 10.55.0.1, 192.168.137.210
#
# It is a real widening: netlink is how you enumerate the host's network
# configuration. Judged worth it because this is a read-only static file server
# whose startup line exists to tell you where to point a browser, and the
# alternative was a line that confidently said the wrong thing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
MemoryMax=128M

# The mount may still be coming up, and a bare port bind can lose a race with
# another restart. Retrying is the whole recovery.
Restart=on-failure
RestartSec=5

# SIGINT takes the same path as Ctrl-C, which main() already handles by
# closing the socket rather than leaving it in TIME_WAIT.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
