.venv/
# Local scratch for things that cannot be re-downloaded and are not ours to
# redistribute: the stock Arduino firmware image and a copy of /opt/openocd.
# See docs/third-party.md.
backup/
# zbuild.sh builds into ~/zephyrproject/build, outside the repo. Anything named
# build/ in here is a stray IDE configure - never source, never committed.
/build/
*.o
*.llext
__pycache__/
compile_commands.json
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The fileshare image and its downloaded contents. Microsoft's installers are
# not ours to redistribute (docs/third-party.md), and the image is ~2 GB of build
# artefact. Rebuild both with share/fetch-vscode.sh + share/build-image.sh.
*.img

# The rendered documentation site. Built from docs/ by tools/build-docs.sh, on
# the board at provisioning time and in CI. Generated HTML in git makes every
# content diff unreadable and goes stale the moment someone forgets to rebuild.
/share/learn/
