# Shell scripts, units and rules are run on the board, where a carriage return
# at the end of a line is part of the command. A checkout made on Windows and
# copied across would otherwise fail with "bad interpreter" or a unit that
# cannot find its own ExecStart.
*.sh        text eol=lf
*.bash      text eol=lf
*.bats      text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.overlay   text eol=lf
*.py        text eol=lf
