//
// Board-wide VS Code Server settings, installed to
// ~/.vscode-server/data/Machine/settings.json by 40-shell-env.sh.
//
// These are the MACHINE-scoped ones: they are about this board having 3.6 GB of
// RAM and a slow-ish disk, not about this project. The project's own settings
// live in .vscode/settings.json and are checked in beside the code they affect.
//
// They used to exist only inside ~/.vscode-server, which meant a factory
// restore silently took them with it - and nothing announced their absence,
// because every one of them is a setting whose default merely costs you
// something rather than breaking anything.
{
  // The README says extension auto-update is deliberately off, because a
  // background download-and-reload of a dozen extensions on a 3.6 GB board is
  // felt. That decision lived nowhere but in this file, so a restore quietly
  // undid it. Run tools/check-versions.sh occasionally instead.
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,

  // The file watcher is the one component whose cost scales with what is on
  // disk rather than what is open. ~/zephyrproject is ~2 GB and the SDK
  // another ~0.8 GB, and neither is ever edited by hand - they are checkouts west
  // manages and a toolchain. Watching them buys nothing and costs an inotify
  // watch per directory.
  "files.watcherExclude": {
    "**/zephyrproject/**": true,
    "**/zephyr-sdk-*/**": true,
    "**/.venv/**": true,
    "**/.cache/**": true,
    "**/twister-out/**": true,
    "**/build/**": true,
    "**/__pycache__/**": true,
    "**/.git/objects/**": true
  },

  // Same trees, for search. Without this, a project-wide find walks 4+ GB of
  // Zephyr and toolchain sources and pushes the board into swap.
  "search.exclude": {
    "**/zephyrproject/**": true,
    "**/zephyr-sdk-*/**": true,
    "**/.venv/**": true,
    "**/twister-out/**": true,
    "**/build/**": true
  },
  "search.followSymlinks": false,

  // Scanning for npm scripts, gulp files and grunt tasks on a board with no
  // node project on it is pure cost.
  "npm.autoDetect": "off",
  "task.autoDetect": "off",
  "typescript.tsserver.useSyntaxServer": "never",

  // Autofetch and autorefresh were BOTH off here, on the reasoning that
  // "git.autofetch wakes the network every few minutes, and on a board whose
  // uplink may be a USB cable to a laptop that is not always sharing, that is
  // pointless and a source of confusing log noise".
  //
  // That was right for a board being developed on alone. It is wrong the moment
  // anyone else - a colleague, or an agent - is pushing branches you are trying
  // to watch: with these off, the Source Control view shows a stale working
  // tree and the branch list never learns that a remote branch exists.
  //
  // autorefresh is the important one and costs nothing over the network: it is
  // what makes the SCM view notice files changing on disk. autofetch is one
  // `git fetch` a minute, which is negligible next to the ~3 GB this board
  // downloads during provisioning.
  "git.autofetch": true,
  "git.autofetchPeriod": 60,
  "git.autorefresh": true,

  "telemetry.telemetryLevel": "off",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,

  // Restoring a dozen editors on window reload means a dozen language-server
  // requests before you have asked for anything.
  "workbench.editor.restoreViewState": false,
  "files.hotExit": "off"
}
