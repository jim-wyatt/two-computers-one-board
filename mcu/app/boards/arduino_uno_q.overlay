/*
 * Copyright (c) 2026 Jim Wyatt
 * SPDX-License-Identifier: MIT
 *
 * Route the Zephyr console to lpuart1 (PG7/PG8, with RTS/CTS) - the UART
 * physically wired to the Linux MPU, where it appears as /dev/ttyHS1.
 * usart1 (PB6/PB7) is the Arduino-header UART and is NOT the MPU link.
 */
/ {
	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
	};
};

/*
 * The 8x13 LED panel. Upstream Zephyr's board does not describe it at all -
 * the wiring is only recorded in Arduino's core - so both halves are declared
 * here: the port the 104 LEDs are charlieplexed across, and the timer that
 * paces the refresh. See mcu/app/src/matrix.c.
 */

/* PF0..PF10 carry the panel. Enabling the port is what turns its clock on;
 * matrix.c then drives MODER/BSRR directly, because the pins have to change
 * direction every 10us. Nothing else in this build may claim PF0..PF10.
 */
&gpiof {
	status = "okay";
};

/* TIM17 is otherwise unused here, and is the timer Arduino's own firmware
 * picks for this job. Prescaler 4 divides the timer clock by 5, which leaves
 * counter_us_to_ticks() plenty of resolution for a 10us slot.
 */
&timers17 {
	status = "okay";
	st,prescaler = <4>;

	counter_matrix: counter {
		status = "okay";
	};
};

/*
 * The die temperature sensor behind `app temp` needs nothing here: Zephyr's
 * board file already sets die_temp and the ADC it is read through (adc1,
 * internal channel 19) to "okay". What it also enables is adc4, for a Vbat
 * sensor this firmware does not build (CONFIG_STM32_VBAT=n in prj.conf).
 *
 * Turning the ADC driver on brings up every enabled ADC at boot, and on this
 * chip that bring-up waits for the converter's regulator in a loop with no
 * timeout. One such wait is the price of the temperature; a second, for a
 * converter nothing reads, is only another way for the board not to boot.
 */
&adc4 {
	status = "disabled";
};

/*
 * The SPI link to Linux. spi3's four pins - SCK PG9, MISO PG10, MOSI PB5, NSS
 * PG12 - are wired to the MPU's spi@4a94000, which Linux shows as
 * /dev/spidev0.0; docs/reference/hardware.md has the experiment that found
 * them. Linux is the master. The board file already enables spi3 with exactly
 * this pinctrl; it is restated here because spi_link.c depends on it, and on
 * NSS being the hardware pin rather than a GPIO chip select.
 */
&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_sck_pg9 &spi3_miso_pg10 &spi3_mosi_pb5 &spi3_nss_pg12>;
	pinctrl-names = "default";
};

/*
 * `app jitter` (main.c, jitter.h): three general-purpose timers, none of
 * which the board file or anything above enables. All three count the APB1
 * timer clock, 160 MHz (sysclk 160 MHz, APB1 prescaler 1), divided by
 * st,prescaler + 1.
 *
 * Header pins, from Zephyr's arduino_r3_connector.dtsi: D2 is PB3 and D3 is
 * PB0. Neither is in the panel's PF0..PF10, spi3's PG9/PG10/PB5/PG12,
 * lpuart1's PG5..PG8, usart1's PB6/PB7, i2c2's PB10/PB11, spi2's
 * PB13/PB14/PB15/PB9, or the status LEDs' PH10..PH15. PB3 comes out of reset
 * as JTDO/TRACESWO; debugging here is SWD on PA13/PA14, which does not use
 * it.
 */

/* TIM5: a free-running 32-bit counter at 1 MHz, so one count is one
 * microsecond and the counter wraps every 71.6 minutes. The tick timestamps.
 * The kernel's own cycle counter is LPTIM1 on the 32768 Hz crystal (the
 * board's stm32_lp_tick_source), about 30 us a count. */
&timers5 {
	status = "okay";
	st,prescaler = <159>;

	counter_jitter: counter {
		status = "okay";
	};
};

/* TIM3: PWM out on D3 (PB0, TIM3_CH3). TIM3 is 16-bit, and counting at 1 MHz
 * its longest period is 65535 us, which is APP_JITTER_PWM_HZ_MIN's reason. */
&timers3 {
	status = "okay";
	st,prescaler = <159>;

	pwm_jitter_out: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch3_pb0>;
		pinctrl-names = "default";
	};
};

/* TIM2: PWM capture in on D2 (PB3, TIM2_CH2), at the full 160 MHz so a
 * period is measured to 6.25 ns. TIM2 is 32-bit, so a period up to 26.8 s
 * fits. Capture on channel 2 uses the slave-mode controller to reset the
 * counter on each rising edge, and channel 1 as its pair, internally: only
 * PB3 is taken. */
&timers2 {
	status = "okay";
	st,prescaler = <0>;

	pwm_jitter_in: pwm {
		status = "okay";
		pinctrl-0 = <&tim2_ch2_pb3>;
		pinctrl-names = "default";
	};
};

/* Without the jumper, D2 is held low rather than left to float, so the
 * capture sees no edges and the pwm histogram stays empty instead of filling
 * with noise. */
&tim2_ch2_pb3 {
	bias-pull-down;
};

/*
 * `app scope` (scope.h, scope_hw.c): a wave out of A0 and sampled back in.
 * Nothing here changes for it; this says what it takes, and why the board
 * file already has it.
 *
 *   PA4   header A0, and both dac1_out1_pa4 (&dac1's pinctrl) and
 *         adc1_in9_pa4 (&adc1's). The ADC driver puts it in analog mode at
 *         boot, which is also what the DAC needs. Not in the panel's
 *         PF0..PF10, spi3's PG9/PG10/PB5/PG12, lpuart1's PG5..PG8, usart1's
 *         PB6/PB7, i2c2's PB10/PB11, spi2's PB13/PB14/PB15/PB9, the status
 *         LEDs' PH10..PH15, or jitter's PB0/PB3.
 *   dac1  "okay" in the board file. CONFIG_DAC is off, so no driver binds
 *         it, and scope_hw.c drives it with LL.
 *   adc1  shared with the die temperature, which the ADC driver reads; a
 *         capture borrows it under adc1_lock (see scope_hw.c).
 *   TIM6  the ADC's trigger; TIM7 the DAC's. Basic timers, left "disabled"
 *         here because no Zephyr driver is to have them: scope_hw.c turns on
 *         their clocks from their nodes' `clocks` and programs them with LL.
 *         Not TIM2, TIM3 or TIM5 (jitter) or TIM17 (the panel).
 *   gpdma1  "okay" in the board file; channels 14 (ADC) and 15 (DAC).
 */

/*
 * `app env` (env.h, env_sensor.c): a BME680 breakout on the header's I2C,
 * i2c2, which Zephyr's board file already enables at 400 kHz on SCL PB10 and
 * SDA PB11 - the two pins past AREF, also labeled SCL and SDA on the board.
 *
 * The part answers on 0x76 with its SDO pin low and 0x77 with it high. This
 * declares 0x77, the address Adafruit's and SparkFun's breakouts ship at and
 * Bosch's and Adafruit's libraries default to. Pimoroni's, and many of the
 * unbranded boards, tie SDO low instead and answer on 0x76; several move with
 * a solder jumper. `i2c scan i2c@40005800` in the MCU's shell says which.
 *
 * For 0x76, build with the CMake variable mcu/app/CMakeLists.txt passes in
 * here, which sticks in that build directory until a pristine build:
 *
 *   mcu/zbuild.sh -- -DUNOQ_BME680_ADDR=0x76
 *
 * Anything but the two addresses the part has stops the build. With no
 * breakout fitted the driver's init fails, the device is not ready, and
 * `app env` says so; nothing else changes.
 */
#ifndef UNOQ_BME680_ADDR
#define UNOQ_BME680_ADDR 0x77
#endif

&i2c2 {
#if UNOQ_BME680_ADDR == 0x76
	env_bme680: bme680@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
	};
#elif UNOQ_BME680_ADDR == 0x77
	env_bme680: bme680@77 {
		compatible = "bosch,bme680";
		reg = <0x77>;
	};
#else
#error "UNOQ_BME680_ADDR: a BME680 answers only on 0x76 or 0x77"
#endif
};
